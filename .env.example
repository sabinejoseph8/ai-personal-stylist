# Copy this file to .env.local and paste each value after the = sign.
# Never commit .env.local. In Vercel, add these under Settings > Environment Variables.

# Provider keys (secret)
TAVUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase server key (secret). Used only on the server: the budget guard, the daily job,
# the catalog loader and automated tests. Never sent to the browser.
SUPABASE_SECRET_KEY=

# The daily clean-up job's secret (secret). Vercel's scheduler sends it; nobody else can run the job.
CRON_SECRET=

# Public values. Optional (remove the # to set one): lib/public-config.ts has them built in.
# Development, previews and the live site share one database until launch.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Budget limits. Optional (remove the # to set one): the defaults are in lib/budget-guard.ts
# (10 minutes and $1 of AI per guest per day; 110 video minutes, $12 of Claude and $4 of OpenAI a month).
# BUDGET_DAILY_CONVERSATION_MINUTES=
# BUDGET_DAILY_AI_USD=
# BUDGET_MONTHLY_VIDEO_MINUTES=
# BUDGET_MONTHLY_CLAUDE_USD=
# BUDGET_MONTHLY_OPENAI_USD=
