{
  "name": "ai-personal-stylist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "catalog:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON catalog/scripts/check-catalog.mjs",
    "catalog:load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON catalog/scripts/load-catalog.mjs",
    "tavus:apply": "node scripts/apply-tavus-pal.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "eval:notes": "vitest run --config vitest.evals.config.mts tests/evals/notes.eval.ts",
    "eval:photos": "vitest run --config vitest.evals.config.mts tests/evals/photos.eval.ts",
    "eval:camera": "vitest run --config vitest.evals.config.mts tests/evals/camera.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@daily-co/daily-js": "^0.94.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "openai": "^7.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
